# Copy to .env.local. Replace every placeholder with real values.
# Signup/login will NOT work until DATABASE_URL points to a real PostgreSQL database.
DATABASE_URL=
BETTER_AUTH_SECRET=
# Local default is inferred from request; set this explicitly for production.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
